# Laravel runtime caches (standard)
/storage/framework/cache/*
!/storage/framework/cache/.gitkeep
/storage/framework/sessions/*
!/storage/framework/sessions/.gitkeep
/storage/framework/testing/*
!/storage/framework/testing/.gitkeep
/storage/framework/views/*
!/storage/framework/views/.gitkeep
/storage/logs/*
!/storage/logs/.gitkeep

# Generated document artifacts (runtime output, not source)
/storage/app/om-manuals/*
!/storage/app/om-manuals/.gitkeep
/storage/app/rams/*
!/storage/app/rams/.gitkeep
/storage/app/tmp/*
!/storage/app/tmp/.gitkeep

# New unified document-artifact disk (H-07). Subdirectories: rams/, om-manuals/,
# worksheets/, cable-schedules/ — all runtime output, not source.
/storage/app/documents/*
!/storage/app/documents/.gitkeep

# Private user uploads (label photos, scratch artifacts) — runtime data, not source.
/storage/app/private/

# Queue worker liveness file — written every tick, never source.
/storage/worker-heartbeat

# Claude Code per-machine state cache.
.claude/

# Local debug + scratch scripts (never deploy to live).
/diag.php
/render()
/resources/views/site-survey/db.php

# Manual view backups (engineer-friendly snapshots before risky edits).
# Pattern catches *.bak-YYMMDD, *.pre-tailwind-bak, etc.
/resources/views.backup-*/
*.bak-*
*.pre-tailwind-bak
*.blade2903.php
